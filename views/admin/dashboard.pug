extends ../layout

block content
  .page-header
    h2.page-title
      i.fas.fa-th-large
      span Overview
    .page-actions
      if role === 'admin' || role === 'teacher'
        a.btn.btn-primary(href="/students/new")
          i.fas.fa-user-plus
          span Add Student

  //- Stat Cards
  .stats-grid
    .stat-card.stat-total
      .stat-icon
        i.fas.fa-users
      .stat-info
        span.stat-label Total Students
        span.stat-value= stats.totalStudents || 0
        span.stat-sub= `${stats.ongoing || 0} ongoing`
    
    .stat-card.stat-boys
      .stat-icon
        i.fas.fa-mars
      .stat-info
        span.stat-label Boys
        span.stat-value= stats.boys || 0
        span.stat-sub= stats.totalStudents ? Math.round((stats.boys/stats.totalStudents)*100) + '%' : '0%'
    
    .stat-card.stat-girls
      .stat-icon
        i.fas.fa-venus
      .stat-info
        span.stat-label Girls
        span.stat-value= stats.girls || 0
        span.stat-sub= stats.totalStudents ? Math.round((stats.girls/stats.totalStudents)*100) + '%' : '0%'
    
    .stat-card.stat-completed
      .stat-icon
        i.fas.fa-user-check
      .stat-info
        span.stat-label Completed
        span.stat-value= stats.completed || 0
        span.stat-sub Graduated
    
    .stat-card.stat-transferred
      .stat-icon
        i.fas.fa-exchange-alt
      .stat-info
        span.stat-label Transferred
        span.stat-value= stats.transferred || 0
        span.stat-sub Moved schools

  //- Chart & Recent
  .dashboard-grid
    .chart-card
      .card-header
        h3 Students by Class
        span.badge Class Distribution
      .chart-wrap
        canvas#classChart(height="280")
    
    .recent-card
      .card-header
        h3 Recently Added
        a.btn-link(href="/students") View All →
      .recent-list
        if recentStudents.length === 0
          .empty-state
            i.fas.fa-inbox
            p No students yet
        each s in recentStudents
          .recent-item
            .student-avatar(class=s.Gender === 'Male' ? 'avatar-boy' : 'avatar-girl')
              = s.StudentFullName.charAt(0)
            .student-info
              span.student-name= s.StudentFullName
              span.student-meta= (s.Class ? s.Class.ClassName : 'N/A') + (s.Stream ? ' · ' + s.Stream.StmName : '')
            .student-status(class=`status-${s.Status.toLowerCase()}`)= s.Status

  //- Bulk Move Section
  if role === 'admin'
    .bulk-section
      .card-header
        h3
          i.fas.fa-arrow-right
          span Promote Entire Class
      form.bulk-form(action="/students/bulk/move" method="POST")
        .form-row
          .form-group
            label From Class
            select(name="fromClassID" required)
              option(value="") Select source class
              each c in JSON.parse(studentsByClass).map(x => x)
                option(value="")= c.name
          .form-group
            label To Class
            select#bulkToClass(name="toClassID" required)
              option(value="") Select destination
          .form-group
            label Set Status
            select(name="setStatus")
              option(value="") Keep as Ongoing
              option(value="Completed") Mark as Completed
              option(value="Transferred") Mark as Transferred
          .form-group.form-submit
            button.btn.btn-warning(type="submit" onclick="return confirm('Promote entire class?')")
              i.fas.fa-level-up-alt
              span Promote Class

block scripts
  script.
    const chartData = !{studentsByClass};
    const ctx = document.getElementById('classChart');
    if (ctx && chartData.length) {
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: chartData.map(d => d.name),
          datasets: [{
            label: 'Students',
            data: chartData.map(d => d.count),
            backgroundColor: chartData.map((_, i) => `hsl(${210 + i * 25}, 75%, ${55 + (i%3)*8}%)`),
            borderRadius: 8,
            borderSkipped: false
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.y} students` } }
          },
          scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.05)' } },
            x: { grid: { display: false } }
          }
        }
      });
    }

    // Populate bulk class selects from page data
    const allClasses = !{studentsByClass};
    const selects = document.querySelectorAll('.bulk-form select[name="fromClassID"], #bulkToClass');
