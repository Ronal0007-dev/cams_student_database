extends ../layout

block content
  .page-header
    h2.page-title
      i.fas.fa-th-large
      span Overview
    .page-actions
      if role === 'admin' || role === 'teacher'
        a.btn.btn-primary(href="/students/new")
          i.fas.fa-user-plus
          span Add Student

  //- ── Stat Cards ──
  .stats-grid
    .stat-card.stat-total
      .stat-icon
        i.fas.fa-users
      .stat-info
        span.stat-label Active Students
        span.stat-value= stats.totalStudents || 0
        span.stat-sub Ongoing only

    .stat-card.stat-boys
      .stat-icon
        i.fas.fa-mars
      .stat-info
        span.stat-label Boys
        span.stat-value= stats.boys || 0
        span.stat-sub= stats.totalStudents ? Math.round((stats.boys / stats.totalStudents) * 100) + '%' : '0%'

    .stat-card.stat-girls
      .stat-icon
        i.fas.fa-venus
      .stat-info
        span.stat-label Girls
        span.stat-value= stats.girls || 0
        span.stat-sub= stats.totalStudents ? Math.round((stats.girls / stats.totalStudents) * 100) + '%' : '0%'

    .stat-card.stat-completed
      .stat-icon
        i.fas.fa-graduation-cap
      .stat-info
        span.stat-label Graduated
        span.stat-value= stats.totalGraduated || 0
        a.stat-link(href="/graduated") View All →

    .stat-card.stat-transferred
      .stat-icon
        i.fas.fa-exchange-alt
      .stat-info
        span.stat-label Transferred
        span.stat-value= stats.totalTransferred || 0
        a.stat-link(href="/transferred") View All →

  //- ── Chart & Recent Students ──
  .dashboard-grid
    .chart-card
      .card-header
        h3 Students by Class
        span.badge Pie Distribution
      .chart-wrap.pie-wrap
        canvas#classChart

    .recent-card
      .card-header
        h3 Recently Added
        a.btn-link(href="/students") View All →
      .recent-list
        if recentStudents.length === 0
          .empty-state
            i.fas.fa-inbox
            p No students yet
        each s in recentStudents
          .recent-item
            .student-avatar(class=s.Gender === 'Male' ? 'avatar-boy' : 'avatar-girl')
              = s.StudentFullName.charAt(0)
            .student-info
              span.student-name= s.StudentFullName
              span.student-meta= (s.Class ? s.Class.ClassName : 'N/A') + (s.Stream ? ' · ' + s.Stream.StmName : '')
            span.status-pill.status-ongoing Ongoing

  //- ── Quick Links ──
  .quick-links-grid
    a.quick-link-card(href="/students")
      i.fas.fa-user-graduate
      span All Students
    a.quick-link-card(href="/graduated")
      i.fas.fa-graduation-cap
      span Graduated
    a.quick-link-card(href="/transferred")
      i.fas.fa-exchange-alt
      span Transferred
    a.quick-link-card(href="/classes")
      i.fas.fa-chalkboard
      span Classes
    a.quick-link-card(href="/departments")
      i.fas.fa-building-columns
      span Departments

block scripts
  script.
    const chartData = !{studentsByClass};
    const ctx = document.getElementById('classChart');
    if (ctx && chartData.length) {
      // Filter only classes with students
      const filtered = chartData.filter(d => d.count > 0);
      const total    = filtered.reduce((s, d) => s + d.count, 0);

      // Generate a rich palette
      const palette = [
        '#3b82f6','#8b5cf6','#10b981','#f59e0b','#ef4444',
        '#06b6d4','#ec4899','#84cc16','#f97316','#6366f1',
        '#14b8a6','#f43f5e','#a855f7','#22c55e','#eab308'
      ];

      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: filtered.map(d => d.name),
          datasets: [{
            data:            filtered.map(d => d.count),
            backgroundColor: filtered.map((_, i) => palette[i % palette.length]),
            borderColor:     'transparent',
            borderWidth: 0,
            hoverOffset: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '60%',
          plugins: {
            legend: {
              position: 'right',
              labels: {
                color:     getComputedStyle(document.documentElement).getPropertyValue('--text-2').trim() || '#94a3b8',
                font:      { family: 'Outfit', size: 12, weight: '500' },
                padding:   12,
                boxWidth:  12,
                boxHeight: 12,
                usePointStyle: true,
                pointStyle: 'circle'
              }
            },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  const pct = total > 0 ? ((ctx.parsed / total) * 100).toFixed(1) : 0;
                  return `  ${ctx.label}: ${ctx.parsed} students (${pct}%)`;
                }
              }
            }
          }
        }
      });
    } else if (ctx) {
      // No data — show message
      const parent = ctx.parentElement;
      parent.innerHTML = '<div class="chart-empty"><i class="fas fa-chart-pie"></i><p>No student data yet</p></div>';
    }
