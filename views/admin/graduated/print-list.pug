doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Graduated Students — Print List
    link(href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet")
    style.
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      body{font-family:'Outfit',sans-serif;background:#fff;color:#1a1a2e;font-size:13px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
      .print-page{padding:24px 32px;max-width:1100px;margin:0 auto}
      .screen-only{margin-bottom:16px;display:flex;gap:10px}
      .screen-only button{padding:8px 18px;border:none;border-radius:8px;cursor:pointer;font-family:inherit;font-weight:600;font-size:0.85rem}
      .btn-print{background:#7c3aed;color:#fff}
      .btn-close{background:#f1f5f9;color:#334155}
      .print-header{display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid #7c3aed;padding-bottom:14px;margin-bottom:18px}
      .school-brand{display:flex;align-items:center;gap:12px}
      .school-icon{width:48px;height:48px;background:linear-gradient(135deg,#7c3aed,#4c1d95);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem}
      .school-name{font-size:1.3rem;font-weight:800;color:#7c3aed}
      .school-sub{font-size:0.75rem;color:#64748b}
      .print-meta{text-align:right;font-size:0.75rem;color:#64748b;line-height:1.6}
      .report-title{font-size:1rem;font-weight:700;color:#1a1a2e;margin-bottom:2px}
      .summary-bar{display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap}
      .summary-pill{background:#f5f3ff;border:1px solid #c4b5fd;border-radius:20px;padding:4px 14px;font-size:0.78rem;font-weight:600;color:#7c3aed}
      .summary-pill.boys{background:#eff6ff;border-color:#93c5fd;color:#1d4ed8}
      .summary-pill.girls{background:#fdf2f8;border-color:#f9a8d4;color:#be185d}
      table{width:100%;border-collapse:collapse;margin-bottom:20px}
      thead tr{background:#7c3aed;color:#fff}
      thead th{padding:9px 10px;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;text-align:left}
      tbody tr:nth-child(even){background:#faf5ff}
      tbody td{padding:8px 10px;border-bottom:1px solid #e2e8f0;font-size:0.82rem;vertical-align:middle}
      .cell-num{color:#94a3b8;font-weight:600;width:36px}
      .badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:0.72rem;font-weight:600}
      .badge-completed{background:#ede9fe;color:#6d28d9}
      .badge-transferred{background:#fef9c3;color:#a16207}
      .badge-male{background:#dbeafe;color:#1d4ed8}
      .badge-female{background:#fce7f3;color:#be185d}
      .print-footer{border-top:1px solid #e2e8f0;padding-top:10px;display:flex;justify-content:space-between;font-size:0.72rem;color:#94a3b8}
      .sig-line{border-top:1px solid #94a3b8;padding-top:4px;margin-top:32px;width:180px;text-align:center;font-size:0.72rem;color:#64748b}
      @media print{.screen-only{display:none!important}thead tr{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
  body
    .print-page
      .screen-only
        button.btn-print(onclick="window.print()") 🖨 Print / Save PDF
        button.btn-close(onclick="window.close()") Close

      .print-header
        .school-brand
          .school-icon 🎓
          div
            .school-name Student Management System
            .school-sub Graduated Students Report
        .print-meta
          .report-title Graduated Students List
          div Printed: #{printDate}

      .summary-bar
        span.summary-pill Total: #{graduates.length}
        span.summary-pill.boys Boys: #{graduates.filter(g=>g.Gender==='Male').length}
        span.summary-pill.girls Girls: #{graduates.filter(g=>g.Gender==='Female').length}
        if query.year
          span.summary-pill Year: #{query.year}

      table
        thead
          tr
            th #
            th Student Full Name
            th Adm. No.
            th Department
            th Class
            th Gender
            th Status
            th Graduation Date
            th Parent Phone
        tbody
          each g, i in graduates
            tr
              td.cell-num= i+1
              td= g.StudentFullName
              td= g.AdmissionNumber || '—'
              td= g.DepartmentName || '—'
              td= g.ClassName || '—'
              td
                span.badge(class=g.Gender==='Male'?'badge-male':'badge-female')= g.Gender
              td
                span.badge(class=`badge-${g.Status.toLowerCase()}`)= g.Status
              td= g.GraduationDate ? new Date(g.GraduationDate).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '—'
              td= g.ParentPhone || '—'

      .print-footer
        div SMS — Graduated Students Report
        div Total: #{graduates.length} students

      div(style="margin-top:40px;display:flex;justify-content:space-between")
        .sig-line Prepared By
        .sig-line Verified By
        .sig-line Date
