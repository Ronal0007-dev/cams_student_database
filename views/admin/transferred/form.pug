extends ../../layout

block content
  .page-header
    h2.page-title
      i.fas.fa-user-edit
      span Edit Transfer Record
    .page-actions
      a.btn.btn-ghost(href="/transferred")
        i.fas.fa-arrow-left
        span Back

  .form-card.form-sm
    //- Identity bar (read-only)
    .grad-identity-bar
      .mini-avatar(class=transfer.Gender === 'Male' ? 'avatar-boy' : 'avatar-girl')
        = transfer.StudentFullName.charAt(0)
      .grad-id-info
        span.grad-id-name= transfer.StudentFullName
        span.grad-id-meta
          | #{transfer.ClassName || 'Unknown Class'} &nbsp;·&nbsp; #{transfer.AdmissionNumber || 'No Admission No.'}

    form(action=action method="POST" class="styled-form")
      input(type="hidden" name="_method" value="PUT")

      .form-section
        h3.section-title
          i.fas.fa-toggle-on
          span Status
        .status-change-block
          .status-option
            input#statusTransferred(type="radio" name="Status" value="Transferred" checked=transfer.Status==='Transferred')
            label(for="statusTransferred")
              .so-icon.so-transferred
                i.fas.fa-exchange-alt
              .so-label
                strong Transferred
                span Moved to another school
          .status-option
            input#statusOngoing(type="radio" name="Status" value="Ongoing" checked=transfer.Status==='Ongoing')
            label(for="statusOngoing")
              .so-icon.so-ongoing
                i.fas.fa-user-check
              .so-label
                strong Ongoing
                span Return to active students
          .status-option
            input#statusCompleted(type="radio" name="Status" value="Completed" checked=transfer.Status==='Completed')
            label(for="statusCompleted")
              .so-icon.so-completed
                i.fas.fa-graduation-cap
              .so-label
                strong Completed
                span Move to graduated list
        .status-warn#statusWarn(style="display:none")
          i.fas.fa-info-circle
          span Changing to <strong id="warnStatus"></strong> will move this student out of the Transferred list.

      .form-section
        h3.section-title
          i.fas.fa-school
          span Transfer Details
        .form-row
          .form-group
            label(for="TransferDate") Transfer Date
            input#TransferDate(type="date" name="TransferDate" value=transfer.TransferDate ? transfer.TransferDate.toString().split('T')[0] : '')
          .form-group.col-2
            label(for="DestinationSchool") Destination School
            input#DestinationSchool(type="text" name="DestinationSchool" value=transfer.DestinationSchool || '' placeholder="Name of school transferred to")

      .form-section
        h3.section-title
          i.fas.fa-phone
          span Parent Contact
        .form-row
          .form-group
            label(for="ParentPhone") Phone Number
            input#ParentPhone(type="tel" name="ParentPhone" value=transfer.ParentPhone || '' placeholder="+255 7XX XXX XXX")
          .form-group.col-2
            label(for="ParentEmail") Email Address
            input#ParentEmail(type="email" name="ParentEmail" value=transfer.ParentEmail || '' placeholder="parent@email.com")

      .form-section
        h3.section-title
          i.fas.fa-sticky-note
          span Notes
        .form-group
          label(for="Address") Address
          textarea#Address(name="Address" rows="2")= transfer.Address || ''
        .form-group
          label(for="Notes") Notes (optional)
          textarea#Notes(name="Notes" rows="2" placeholder="Reason for transfer, additional details...")= transfer.Notes || ''

      .form-actions
        button.btn.btn-primary(type="submit")
          i.fas.fa-save
          span Save Changes
        a.btn.btn-ghost(href="/transferred") Cancel

block scripts
  script.
    const radios = document.querySelectorAll('input[name="Status"]');
    const warn   = document.getElementById('statusWarn');
    const warnTxt= document.getElementById('warnStatus');
    radios.forEach(r => r.addEventListener('change', function() {
      if (this.value !== 'Transferred') {
        warn.style.display = 'flex';
        warnTxt.textContent = this.value;
      } else {
        warn.style.display = 'none';
      }
    }));
