doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Transferred Students — Print List
    link(href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet")
    style.
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      body{font-family:'Outfit',sans-serif;background:#fff;color:#1a1a2e;font-size:13px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
      .print-page{padding:24px 32px;max-width:1100px;margin:0 auto}
      .screen-only{margin-bottom:16px;display:flex;gap:10px}
      .screen-only button{padding:8px 18px;border:none;border-radius:8px;cursor:pointer;font-family:inherit;font-weight:600;font-size:.85rem}
      .btn-print{background:#f59e0b;color:#1a1a1a}
      .btn-close{background:#f1f5f9;color:#334155}
      .print-header{display:flex;align-items:center;justify-content:space-between;border-bottom:3px solid #d97706;padding-bottom:14px;margin-bottom:18px}
      .school-brand{display:flex;align-items:center;gap:12px}
      .school-icon{width:48px;height:48px;background:linear-gradient(135deg,#d97706,#b45309);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem}
      .school-name{font-size:1.3rem;font-weight:800;color:#d97706}
      .school-sub{font-size:.75rem;color:#64748b}
      .print-meta{text-align:right;font-size:.75rem;color:#64748b;line-height:1.6}
      .report-title{font-size:1rem;font-weight:700;margin-bottom:2px}
      .summary-bar{display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap}
      .summary-pill{background:#fffbeb;border:1px solid #fde68a;border-radius:20px;padding:4px 14px;font-size:.78rem;font-weight:600;color:#d97706}
      .summary-pill.boys{background:#eff6ff;border-color:#93c5fd;color:#1d4ed8}
      .summary-pill.girls{background:#fdf2f8;border-color:#f9a8d4;color:#be185d}
      table{width:100%;border-collapse:collapse;margin-bottom:20px}
      thead tr{background:#d97706;color:#fff}
      thead th{padding:9px 10px;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;text-align:left}
      tbody tr:nth-child(even){background:#fffbeb}
      tbody td{padding:8px 10px;border-bottom:1px solid #e2e8f0;font-size:.82rem;vertical-align:middle}
      .cell-num{color:#94a3b8;font-weight:600;width:36px}
      .badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:.72rem;font-weight:600}
      .badge-male{background:#dbeafe;color:#1d4ed8}
      .badge-female{background:#fce7f3;color:#be185d}
      .print-footer{border-top:1px solid #e2e8f0;padding-top:10px;display:flex;justify-content:space-between;font-size:.72rem;color:#94a3b8}
      .sig-line{border-top:1px solid #94a3b8;padding-top:4px;margin-top:32px;width:180px;text-align:center;font-size:.72rem;color:#64748b}
      @media print{.screen-only{display:none!important}thead tr{-webkit-print-color-adjust:exact;print-color-adjust:exact}tbody tr:nth-child(even){-webkit-print-color-adjust:exact;print-color-adjust:exact}}
  body
    .print-page
      .screen-only
        button.btn-print(onclick="window.print()") 🖨 Print / Save PDF
        button.btn-close(onclick="window.close()") Close

      .print-header
        .school-brand
          .school-icon ↗
          div
            .school-name Student Management System
            .school-sub Transferred Students Report
        .print-meta
          .report-title Transferred Students List
          div Printed: #{printDate}

      .summary-bar
        span.summary-pill Total: #{transfers.length}
        span.summary-pill.boys Boys: #{transfers.filter(t=>t.Gender==='Male').length}
        span.summary-pill.girls Girls: #{transfers.filter(t=>t.Gender==='Female').length}
        if query.year
          span.summary-pill Year: #{query.year}

      table
        thead
          tr
            th #
            th Student Full Name
            th Adm. No.
            th Department
            th Class
            th Gender
            th Destination School
            th Transfer Date
            th Parent Phone
        tbody
          each t, i in transfers
            tr
              td.cell-num= i+1
              td= t.StudentFullName
              td= t.AdmissionNumber || '—'
              td= t.DepartmentName || '—'
              td= t.ClassName || '—'
              td
                span.badge(class=t.Gender==='Male'?'badge-male':'badge-female')= t.Gender
              td= t.DestinationSchool || '—'
              td= t.TransferDate ? new Date(t.TransferDate).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '—'
              td= t.ParentPhone || '—'

      .print-footer
        div SMS — Transferred Students Report
        div Total: #{transfers.length} students

      div(style="margin-top:40px;display:flex;justify-content:space-between")
        .sig-line Prepared By
        .sig-line Verified By
        .sig-line Date
