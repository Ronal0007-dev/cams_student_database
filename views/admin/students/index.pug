extends ../../layout

block content
  .page-header
    h2.page-title
      i.fas.fa-user-graduate
      span Students
      span.count-badge= count
    .page-actions
      if role === 'admin'
        button.btn.btn-warning#promoteBtn(type="button")
          i.fas.fa-level-up-alt
          span Promote Class
      button.btn.btn-secondary#printBtn(type="button")
        i.fas.fa-print
        span Print List
      a.btn.btn-secondary(href="/students/import-csv")
          i.fas.fa-file-import
          span Import CSV
      if role !== 'viewer'
        a.btn.btn-primary(href="/students/new")
          i.fas.fa-user-plus
          span Add Student

  //- ── Filters ──
  form.filter-bar#filterForm(method="GET" action="/students")
    .filter-group
      i.fas.fa-search
      input(type="text" name="search" placeholder="Search students..." value=query.search || '')
    .filter-group
      select(name="classId" onchange="this.form.submit()")
        option(value="") All Classes
        each c in classes
          option(value=c.ClassID selected=(query.classId == c.ClassID))= c.ClassName
    .filter-group
      select(name="gender" onchange="this.form.submit()")
        option(value="") All Gender
        option(value="Male"   selected=(query.gender==='Male'))   Male
        option(value="Female" selected=(query.gender==='Female')) Female
    button.btn.btn-secondary(type="submit")
      i.fas.fa-filter
      span Filter
    if query.search || query.classId || query.gender
      a.btn.btn-ghost(href="/students") Clear

  //- ── Table ──
  .table-card
    if students.length === 0
      .empty-state
        i.fas.fa-user-slash
        p No students found
        if role !== 'viewer'
          a.btn.btn-primary(href="/students/new") Add First Student
    else
      .table-wrap
        table.data-table#studentTable
          thead
            tr
              th #
              th Student Name
              th Class
              th Stream
              th Gender
              th Status
              th Parent Contact
              th.no-print Actions
          tbody
            each s, i in students
              tr
                td.cell-num= (currentPage - 1) * pageSize + i + 1
                td
                  .student-cell
                    .mini-avatar(class=s.Gender === 'Male' ? 'avatar-boy' : 'avatar-girl')
                      = s.StudentFullName.charAt(0)
                    span= s.StudentFullName
                td= s.Class  ? s.Class.ClassName  : '—'
                td= s.Stream ? s.Stream.StmName   : '—'
                td
                  span.gender-badge(class=s.Gender === 'Male' ? 'gender-m' : 'gender-f')
                    i(class=s.Gender === 'Male' ? 'fas fa-mars' : 'fas fa-venus')
                    = ' ' + s.Gender
                td
                  span.status-pill(class=`status-${s.Status.toLowerCase()}`)= s.Status
                td
                  if s.ParentPhone
                    a.contact-link(href=`tel:${s.ParentPhone}` title=s.ParentPhone)
                      i.fas.fa-phone
                  if s.ParentEmail
                    a.contact-link(href=`mailto:${s.ParentEmail}` title=s.ParentEmail)
                      i.fas.fa-envelope
                td.actions-cell.no-print
                  a.btn-icon.btn-view(href=`/students/${s.StudentID}` title="View")
                    i.fas.fa-eye
                  if role !== 'viewer'
                    a.btn-icon.btn-edit(href=`/students/${s.StudentID}/edit` title="Edit")
                      i.fas.fa-pen
                    button.btn-icon.btn-move(type="button" onclick=`openMoveModal(${s.StudentID},'${s.StudentFullName.replace(/'/g,"\\'")}',${s.ClassID})` title="Move Student")
                      i.fas.fa-arrows-alt
                  if role === 'admin'
                    form(action=`/students/${s.StudentID}?_method=DELETE` method="POST" style="display:inline")
                      button.btn-icon.btn-delete(type="submit" onclick="return confirm('Delete this student?')" title="Delete")
                        i.fas.fa-trash

      //- Pagination
      if totalPages > 1
        .pagination
          if currentPage > 1
            a.page-btn(href=`/students?page=${currentPage - 1}&search=${query.search||''}&classId=${query.classId||''}&status=${query.status||''}&gender=${query.gender||''}`)
              i.fas.fa-chevron-left
          - let pStart = Math.max(1, currentPage - 2)
          - let pEnd   = Math.min(totalPages, currentPage + 2)
          if pStart > 1
            a.page-btn(href=`/students?page=1&search=${query.search||''}&classId=${query.classId||''}&status=${query.status||''}&gender=${query.gender||''}`) 1
            if pStart > 2
              span.page-ellipsis …
          each n in Array.from({length: pEnd - pStart + 1}, (_, i) => pStart + i)
            a.page-btn(href=`/students?page=${n}&search=${query.search||''}&classId=${query.classId||''}&status=${query.status||''}&gender=${query.gender||''}` class=(n === currentPage ? 'active' : ''))= n
          if pEnd < totalPages
            if pEnd < totalPages - 1
              span.page-ellipsis …
            a.page-btn(href=`/students?page=${totalPages}&search=${query.search||''}&classId=${query.classId||''}&status=${query.status||''}&gender=${query.gender||''}`)= totalPages
          if currentPage < totalPages
            a.page-btn(href=`/students?page=${currentPage + 1}&search=${query.search||''}&classId=${query.classId||''}&status=${query.status||''}&gender=${query.gender||''}`)
              i.fas.fa-chevron-right

        .pagination-info Showing #{(currentPage - 1) * pageSize + 1}–#{Math.min(currentPage * pageSize, count)} of #{count} students

  //- ══════════════════════════════════
  //- Move Single Student Modal
  //- ══════════════════════════════════
  #moveModal.modal(style="display:none")
    .modal-overlay(onclick="closeMoveModal()")
    .modal-box
      .modal-header
        h3
          i.fas.fa-arrows-alt
          span Move Student
        button.modal-close(type="button" onclick="closeMoveModal()") ×
      .modal-body
        p.modal-student-name#moveStudentName
        form#moveForm(method="POST")
          .form-group
            label Destination Class
            select#moveClassSelect(name="newClassID" required onchange="loadStreams(this.value,'moveStreamSelect')")
              option(value="") Select class...
              each c in classes
                option(value=c.ClassID)= c.ClassName
          .form-group
            label Stream (optional)
            select#moveStreamSelect(name="newStmID")
              option(value="") Select stream...
          .form-group
            label Update Status
            select(name="newStatus")
              option(value="")            Keep current status
              option(value="Ongoing")     Ongoing
              option(value="Completed")   Completed
              option(value="Transferred") Transferred
          .modal-actions
            button.btn.btn-primary(type="submit")
              i.fas.fa-check
              span Confirm Move
            button.btn.btn-ghost(type="button" onclick="closeMoveModal()") Cancel

  //- ══════════════════════════════════
  //- Promote Entire Class Modal
  //- ══════════════════════════════════
  #promoteModal.modal(style="display:none")
    .modal-overlay(onclick="closePromoteModal()")
    .modal-box.promote-modal-box
      .modal-header
        h3
          i.fas.fa-level-up-alt
          span Promote Entire Class
        button.modal-close(type="button" onclick="closePromoteModal()") ×

      .modal-body
        .promote-info-bar
          i.fas.fa-info-circle
          span This moves <strong>all Ongoing students</strong> from one class to another.

        form#promoteForm(action="/students/bulk/move" method="POST")

          //- Step visual
          .promote-steps
            //- FROM
            .promote-step
              .step-badge.step-from FROM
              .form-group
                label(for="promoteFrom") Source Class *
                select#promoteFrom(name="fromClassID" required)
                  option(value="") — select class —
                  each c in classes
                    option(value=c.ClassID)= c.ClassName

              //- Live preview of students to be moved
              #fromPreview.promote-preview(style="display:none")
                .preview-header
                  i.fas.fa-users
                  span#previewCount Loading...
                .preview-names#previewNames

            //- Arrow
            .promote-divider
              .promote-arrow-circle
                i.fas.fa-arrow-right

            //- TO
            .promote-step
              .step-badge.step-to TO
              .form-group
                label(for="promoteTo") Destination Class *
                select#promoteTo(name="toClassID" required)
                  option(value="") — select class —
                  each c in classes
                    option(value=c.ClassID)= c.ClassName

              .form-group
                label(for="promoteStream") Assign Stream (optional)
                select#promoteStream(name="toStmID")
                  option(value="") No specific stream
              .form-group
                label(for="promoteStatus") Set Status After Promotion
                select#promoteStatus(name="setStatus")
                  option(value="")            Keep as Ongoing
                  option(value="Completed")   Mark as Completed
                  option(value="Transferred") Mark as Transferred

          //- Summary bar
          #promoteSummary.promote-summary(style="display:none")
            i.fas.fa-exchange-alt
            span#summaryText

          .modal-actions
            button.btn.btn-warning#doPromoteBtn(type="submit" disabled)
              i.fas.fa-level-up-alt
              span#doPromotetText Promote Class
            button.btn.btn-ghost(type="button" onclick="closePromoteModal()") Cancel

block scripts
  script.
    // ════════════════════════════════
    //  Move single student
    // ════════════════════════════════
    function openMoveModal(id, name, classId) {
      document.getElementById('moveStudentName').textContent = 'Moving: ' + name;
      document.getElementById('moveForm').action = '/students/' + id + '/move';
      document.getElementById('moveClassSelect').value = classId;
      loadStreams(classId, 'moveStreamSelect');
      document.getElementById('moveModal').style.display = 'flex';
    }
    function closeMoveModal() {
      document.getElementById('moveModal').style.display = 'none';
    }

    // ════════════════════════════════
    //  Promote entire class
    // ════════════════════════════════
    document.getElementById('promoteBtn').addEventListener('click', function() {
      document.getElementById('promoteModal').style.display = 'flex';
    });

    function closePromoteModal() {
      document.getElementById('promoteModal').style.display = 'none';
    }

    // When FROM class changes — fetch student list for preview
    document.getElementById('promoteFrom').addEventListener('change', async function() {
      const classId  = this.value;
      const preview  = document.getElementById('fromPreview');
      const summary  = document.getElementById('promoteSummary');
      const btn      = document.getElementById('doPromoteBtn');

      if (!classId) {
        preview.style.display  = 'none';
        summary.style.display  = 'none';
        btn.disabled = true;
        return;
      }

      preview.style.display = 'block';
      document.getElementById('previewCount').textContent = 'Loading students…';
      document.getElementById('previewNames').innerHTML   = '<span class="preview-loading-txt"><i class="fas fa-spinner fa-spin"></i> Fetching…</span>';

      try {
        const r    = await fetch('/students/api/class-count/' + classId);
        const data = await r.json();
        const cnt  = data.count;

        document.getElementById('previewCount').textContent =
          cnt + ' Ongoing student' + (cnt !== 1 ? 's' : '') + ' in ' + data.className;

        if (cnt === 0) {
          document.getElementById('previewNames').innerHTML =
            '<span class="preview-empty">No ongoing students in this class.</span>';
          btn.disabled = true;
        } else {
          // Fetch actual names (up to 8 to show)
          const r2   = await fetch('/students?classId=' + classId + '&status=Ongoing&page=1');
          const html = await r2.text();
          const parser = new DOMParser();
          const doc  = parser.parseFromString(html, 'text/html');
          const rows = doc.querySelectorAll('#studentTable tbody tr');
          let names  = '';
          const max  = Math.min(rows.length, 8);
          for (let i = 0; i < max; i++) {
            const nm = rows[i].querySelector('.student-cell span');
            const cl = rows[i].querySelectorAll('td')[2];
            if (nm) names += '<span class="preview-name-chip">' + nm.textContent.trim() + '</span>';
          }
          if (cnt > 8) names += '<span class="preview-name-chip preview-more">+' + (cnt - 8) + ' more</span>';
          document.getElementById('previewNames').innerHTML = names || '<span class="preview-empty">—</span>';
          btn.disabled = false;
        }
      } catch(e) {
        document.getElementById('previewCount').textContent = 'Could not load preview';
        document.getElementById('previewNames').innerHTML   = '';
        btn.disabled = false;
      }
      refreshSummary();
    });

    // When TO class changes — load its streams
    document.getElementById('promoteTo').addEventListener('change', function() {
      loadStreams(this.value, 'promoteStream');
      refreshSummary();
    });

    document.getElementById('promoteStatus').addEventListener('change', refreshSummary);

    function refreshSummary() {
      const from   = document.getElementById('promoteFrom');
      const to     = document.getElementById('promoteTo');
      const status = document.getElementById('promoteStatus');
      const bar    = document.getElementById('promoteSummary');
      const txt    = document.getElementById('summaryText');
      const btn    = document.getElementById('doPromoteBtn');

      if (from.value && to.value) {
        if (from.value === to.value) {
          txt.textContent = '⚠ Source and destination cannot be the same class.';
          bar.style.display = 'flex';
          bar.className     = 'promote-summary promote-summary-warn';
          btn.disabled      = true;
        } else {
          const fn = from.options[from.selectedIndex].text;
          const tn = to.options[to.selectedIndex].text;
          const st = status.value ? ' · Status → ' + status.value : '';
          txt.textContent   = fn + '  →  ' + tn + st;
          bar.style.display = 'flex';
          bar.className     = 'promote-summary';
          // Only enable if there are students (checked in from-change handler)
          const cnt = parseInt(document.getElementById('previewCount').textContent) || 0;
          btn.disabled = (cnt === 0);
        }
      } else {
        bar.style.display = 'none';
      }
    }

    // Final confirm before submit
    document.getElementById('promoteForm').addEventListener('submit', function(e) {
      const from = document.getElementById('promoteFrom');
      const to   = document.getElementById('promoteTo');
      if (!from.value || !to.value) { e.preventDefault(); return; }
      if (from.value === to.value)  { e.preventDefault(); alert('Source and destination cannot be the same.'); return; }
      const fn = from.options[from.selectedIndex].text;
      const tn = to.options[to.selectedIndex].text;
      if (!confirm('Promote ALL ongoing students from\n"' + fn + '"  →  "' + tn + '"\n\nThis cannot be undone. Continue?')) {
        e.preventDefault();
      }
    });

    // ════════════════════════════════
    //  Print
    // ════════════════════════════════
    document.getElementById('printBtn').addEventListener('click', function() {
      const params = new URLSearchParams(window.location.search);
      params.delete('page');
      window.open('/students/print?' + params.toString(), '_blank');
    });

    // ════════════════════════════════
    //  Stream loader (shared)
    // ════════════════════════════════
    async function loadStreams(classId, selectId, preselect) {
      const sel = document.getElementById(selectId);
      if (!sel) return;
      sel.innerHTML = '<option value="">Loading…</option>';
      if (!classId) { sel.innerHTML = '<option value="">No specific stream</option>'; return; }
      try {
        const res     = await fetch('/streams/by-class/' + classId);
        const streams = await res.json();
        sel.innerHTML = '<option value="">No specific stream</option>' +
          streams.map(s => '<option value="' + s.StmID + '"' + (preselect == s.StmID ? ' selected' : '') + '>' + s.StmName + '</option>').join('');
      } catch(e) {
        sel.innerHTML = '<option value="">Error loading</option>';
      }
    }
