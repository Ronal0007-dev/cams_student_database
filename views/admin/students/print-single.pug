doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= `Student Profile — ${student.StudentFullName}`
    link(href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet")
    style.
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Outfit', sans-serif;
        background: #f1f5f9;
        color: #0f172a;
        font-size: 13px;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .page {
        max-width: 780px;
        margin: 24px auto;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 40px rgba(0,0,0,0.12);
      }

      /* ── Screen toolbar ── */
      .screen-toolbar {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 20px;
        background: #1e293b; border-radius: 12px 12px 0 0;
      }
      .screen-toolbar button {
        padding: 7px 18px; border: none; border-radius: 8px;
        cursor: pointer; font-family: inherit; font-size: 0.82rem; font-weight: 600;
        display: inline-flex; align-items: center; gap: 6px;
        transition: filter 0.2s;
      }
      .btn-print { background: #3b82f6; color: #fff; }
      .btn-print:hover { filter: brightness(1.1); }
      .btn-close { background: #334155; color: #cbd5e1; }
      .btn-close:hover { background: #475569; }
      .toolbar-spacer { flex: 1; }
      .toolbar-info { font-size: 0.75rem; color: #64748b; }

      /* ── Top gradient header ── */
      .card-header {
        background: linear-gradient(135deg, #1e3a8a 0%, #312e81 50%, #4c1d95 100%);
        padding: 28px 32px;
        display: flex; align-items: center; gap: 20px;
        color: #fff;
        position: relative; overflow: hidden;
      }
      .card-header::before {
        content: '';
        position: absolute; top: -40px; right: -40px;
        width: 180px; height: 180px;
        border-radius: 50%;
        background: rgba(255,255,255,0.06);
      }
      .card-header::after {
        content: '';
        position: absolute; bottom: -60px; right: 60px;
        width: 220px; height: 220px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
      }

      .student-avatar-print {
        width: 72px; height: 72px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; font-weight: 800; color: #fff; flex-shrink: 0;
        border: 3px solid rgba(255,255,255,0.3);
        position: relative; z-index: 1;
      }
      .avatar-male   { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
      .avatar-female { background: linear-gradient(135deg, #db2777, #be185d); }

      .header-meta { flex: 1; position: relative; z-index: 1; }
      .student-name {
        font-size: 1.5rem; font-weight: 800;
        letter-spacing: 0.01em; margin-bottom: 6px;
      }
      .header-tags { display: flex; gap: 8px; flex-wrap: wrap; }
      .htag {
        display: inline-flex; align-items: center; gap: 4px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 20px; padding: 3px 10px;
        font-size: 0.72rem; font-weight: 600;
      }

      .school-brand {
        text-align: right; position: relative; z-index: 1; flex-shrink: 0;
      }
      .brand-icon {
        width: 48px; height: 48px; border-radius: 10px;
        background: rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; margin-left: auto; margin-bottom: 4px;
      }
      .brand-name { font-size: 0.9rem; font-weight: 800; letter-spacing: 0.08em; }
      .brand-sub  { font-size: 0.65rem; opacity: 0.7; }

      /* ── Admission number banner ── */
      .adm-banner {
        background: #eff6ff; border-bottom: 1px solid #bfdbfe;
        padding: 10px 32px;
        display: flex; align-items: center; justify-content: space-between;
      }
      .adm-banner-left {
        display: flex; align-items: center; gap: 10px;
      }
      .adm-number-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.1rem; font-weight: 700; color: #1d4ed8;
        letter-spacing: 0.05em;
      }
      .adm-label { font-size: 0.72rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; }
      .adm-date  { font-size: 0.78rem; color: #64748b; }

      /* ── Info sections ── */
      .info-sections {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        border-top: 1px solid #e2e8f0;
      }
      .info-section {
        padding: 20px 24px;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
      }
      .info-section:last-child { border-right: none; }
      .info-section.full-width {
        grid-column: span 2;
        border-right: none;
      }

      .section-title {
        font-size: 0.68rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.12em;
        color: #64748b; margin-bottom: 12px;
        display: flex; align-items: center; gap: 6px;
        padding-bottom: 8px; border-bottom: 2px solid #f1f5f9;
      }
      .section-title span.dot {
        width: 6px; height: 6px; border-radius: 50%;
        display: inline-block; flex-shrink: 0;
      }
      .dot-academic { background: #3b82f6; }
      .dot-personal { background: #8b5cf6; }
      .dot-parent   { background: #10b981; }

      .info-row {
        display: flex; align-items: flex-start;
        padding: 7px 0; border-bottom: 1px solid #f8fafc;
        gap: 12px;
      }
      .info-row:last-child { border-bottom: none; }
      .info-key {
        font-size: 0.75rem; font-weight: 600; color: #94a3b8;
        min-width: 110px; flex-shrink: 0; padding-top: 1px;
      }
      .info-val {
        font-size: 0.82rem; font-weight: 600; color: #1e293b;
        word-break: break-word;
      }
      .info-val.mono { font-family: 'JetBrains Mono', monospace; color: #2563eb; }

      /* Status & gender inline badges */
      .badge-status {
        display: inline-block; padding: 2px 9px; border-radius: 20px;
        font-size: 0.7rem; font-weight: 700;
      }
      .badge-ongoing     { background: #dcfce7; color: #15803d; }
      .badge-completed   { background: #dbeafe; color: #1d4ed8; }
      .badge-transferred { background: #fef9c3; color: #a16207; }
      .badge-male        { background: #dbeafe; color: #1d4ed8; }
      .badge-female      { background: #fce7f3; color: #be185d; }

      /* ── Photo placeholder ── */
      .photo-box {
        width: 100px; height: 120px;
        border: 2px dashed #cbd5e1; border-radius: 8px;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        color: #cbd5e1; font-size: 0.65rem; gap: 6px;
        margin-left: auto;
      }
      .photo-box svg { width: 32px; height: 32px; fill: #e2e8f0; }

      /* ── Signature row ── */
      .signature-row {
        display: flex; justify-content: space-between;
        padding: 20px 32px;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
        gap: 20px;
      }
      .sig-block { flex: 1; text-align: center; }
      .sig-line {
        border-top: 1px solid #94a3b8;
        padding-top: 5px; margin-top: 28px;
        font-size: 0.7rem; color: #64748b; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.06em;
      }

      /* ── Footer ── */
      .card-footer {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 32px;
        background: #1e3a8a; color: rgba(255,255,255,0.6);
        font-size: 0.68rem;
      }
      .footer-left  { display: flex; align-items: center; gap: 8px; }
      .footer-right { color: rgba(255,255,255,0.4); }

      /* ── Print media ── */
      @media print {
        body { background: #fff; }
        .page {
          margin: 0; max-width: 100%;
          box-shadow: none; border-radius: 0;
        }
        .screen-toolbar { display: none !important; }
        .card-header { border-radius: 0; }
      }

      @page {
        size: A4;
        margin: 10mm 12mm;
      }

  body
    .page
      //- Screen toolbar
      .screen-toolbar
        button.btn-print(onclick="window.print()")
          svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16")
            path(d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z")
            path(d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z")
          span Print / Save PDF
        button.btn-close(onclick="window.close()") ✕ Close
        span.toolbar-spacer
        span.toolbar-info Printed: #{printDate}

      //- Header
      .card-header
        .student-avatar-print(class=student.Gender === 'Male' ? 'avatar-male' : 'avatar-female')
          = student.StudentFullName.charAt(0).toUpperCase()
        .header-meta
          .student-name= student.StudentFullName
          .header-tags
            span.htag
              | #{student.Status}
            span.htag
              | #{student.Gender}
            if student.Class
              span.htag
                | #{student.Class.ClassName}
            if student.Stream
              span.htag
                | #{student.Stream.StmName}
        .school-brand
          .brand-icon 🎓
          .brand-name SMS
          .brand-sub Student Management System

      //- Admission Number Banner
      .adm-banner
        .adm-banner-left
          div
            .adm-label Admission Number
            .adm-number-badge= student.AdmissionNumber || 'NOT ASSIGNED'
        .adm-date
          | Admission Date:&nbsp;
          strong= student.AdmissionDate ? new Date(student.AdmissionDate).toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'}) : '—'

      //- Info Grid
      .info-sections

        //- Academic Info
        .info-section
          .section-title
            span.dot.dot-academic
            | Academic Information
          .info-row
            span.info-key Department
            span.info-val= student.Class && student.Class.Department ? student.Class.Department.DeptName : '—'
          .info-row
            span.info-key Class
            span.info-val= student.Class ? student.Class.ClassName : '—'
          .info-row
            span.info-key Stream
            span.info-val= student.Stream ? student.Stream.StmName : '—'
          .info-row
            span.info-key Status
            span.info-val
              span.badge-status(class=`badge-${student.Status.toLowerCase()}`)= student.Status

        //- Personal Info
        .info-section
          .section-title
            span.dot.dot-personal
            | Personal Information
          .info-row
            span.info-key Gender
            span.info-val
              span.badge-status(class=student.Gender === 'Male' ? 'badge-male' : 'badge-female')= student.Gender
          .info-row
            span.info-key Date of Birth
            span.info-val= student.DateOfBirth ? new Date(student.DateOfBirth).toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'}) : '—'
          .info-row
            span.info-key Address
            span.info-val= student.Address || '—'
          .info-row
            span.info-key Printed On
            span.info-val= printDate

        //- Parent / Guardian
        .info-section
          .section-title
            span.dot.dot-parent
            | Parent / Guardian Contact
          .info-row
            span.info-key Phone Number
            span.info-val= student.ParentPhone || '—'
          .info-row
            span.info-key Email Address
            span.info-val= student.ParentEmail || '—'

        //- Photo placeholder
        .info-section
          .section-title
            span.dot(style="background:#f59e0b")
            | Photo
          .photo-box
            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
              path(d="M12 12c2.7 0 4-1.7 4-4s-1.3-4-4-4-4 1.7-4 4 1.3 4 4 4zm0 2c-2.7 0-8 1.3-8 4v1h16v-1c0-2.7-5.3-4-8-4z")
            | Photo Here

      //- Signatures
      .signature-row
        .sig-block
          .sig-line Class Teacher
        .sig-block
          .sig-line Head of Department
        .sig-block
          .sig-line Head Teacher / Principal
        .sig-block
          .sig-line Date

      //- Footer
      .card-footer
        .footer-left
          span SMS — Student Management System
          span · Student Profile Card
        .footer-right= `Ref: ${student.AdmissionNumber || student.StudentID}`

    script.
      // Auto-focus print dialog — remove if not desired
      // window.onload = () => window.print();
